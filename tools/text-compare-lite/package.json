{
  "name": "text-compare-lite",
  "version": "1.0.0",
  "description": "Open-source text diff that runs in your browser: text, code, Word, Excel, PDF and images. No accounts, no uploads.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8785",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:blog": "playwright test --config playwright.ydd.config.ts"
  },
  "author": "James Patton",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "lz-string": "^1.5.0",
    "pdfjs-dist": "^6.3.289",
    "re2js": "^2.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "private": true,
  "funding": "https://buymeacoffee.com/Clayberd",
  "homepage": "https://text.compare",
  "repository": {
    "type": "git",
    "url": "https://github.com/JamesClayPatton/text-compare-lite.git"
  },
  "engines": {
    "node": ">=22.12"
  }
}
